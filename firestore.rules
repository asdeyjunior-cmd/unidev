rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Si vous changez le prix ou le pack dans js/config.js, changez-les aussi ici
    function prixPack() { return 100; }
    function creditsParPack() { return 5; }
    function creditsBienvenue() { return 2; } // = CREDITS_BIENVENUE dans js/config.js

    // Seuls les fichiers de TON compte Cloudinary sont acceptés
    // Comptes Cloudinary autorisés : les mêmes noms que dans js/config.js (comptes)
    function comptesCloudinary() { return '(iugeyztf|qxh2bmzt|jbqiyzzu|gxmx1dsh|nis5hqzo)'; }
    function cloudinaryRaw() { return 'https://res\\.cloudinary\\.com/' + comptesCloudinary() + '/raw/upload/.+'; }
    function cloudinaryImage() { return 'https://res\\.cloudinary\\.com/' + comptesCloudinary() + '/image/upload/.+'; }
    // Stockage Cloudflare R2 (serveur unidev) : fichiers envoyés par les étudiants
    function stockageR2(dossier) { return 'https://unidev-paiement\\.asdeyjunior40\\.workers\\.dev/f/' + dossier + '/.+'; }
    function texte(champ, max) {
      return !(champ in request.resource.data)
        || (request.resource.data[champ] is string && request.resource.data[champ].size() <= max);
    }

    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function achatPath(uid, docId) { return /databases/$(database)/documents/users/$(uid)/achats/$(docId); }
    // Un seul admin : son UID est dans parametres/admin (créé à la main dans la console)
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/parametres/admin)
        && get(/databases/$(database)/documents/parametres/admin).data.uid == request.auth.uid;
    }
    function onlyKeys(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    /* ---------- Utilisateurs ---------- */
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // Création : toujours "etudiant" avec les crédits de bienvenue
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nom', 'email', 'role', 'credits', 'createdAt', 'bonusEnAttente'])
        && request.resource.data.role == 'etudiant'
        // Crédits offerts : seulement si l'e-mail est vérifié (sinon 0, réclamés après vérification)
        && (
          (request.resource.data.credits == 0 && request.resource.data.get('bonusEnAttente', false) is bool)
          || (request.resource.data.credits == creditsBienvenue()
              && request.resource.data.get('bonusEnAttente', false) == false
              && request.auth.token.email_verified == true)
        )
        && texte('nom', 80) && texte('email', 120);

      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role
            && (
              (onlyKeys(['nom']) && texte('nom', 80))
              // Crédits offerts réclamés une seule fois, après vérification de l'e-mail
              || (onlyKeys(['credits', 'bonusEnAttente'])
                  && resource.data.get('bonusEnAttente', false) == true
                  && request.resource.data.bonusEnAttente == false
                  && request.resource.data.credits == resource.data.get('credits', 0) + creditsBienvenue()
                  && request.auth.token.email_verified == true)
              // Dépense d'1 crédit : uniquement en même temps que la création d'un achat
              || (onlyKeys(['credits', 'dernierAchat'])
                  && resource.data.get('credits', 0) >= 1
                  && request.resource.data.credits == resource.data.get('credits', 0) - 1
                  && existsAfter(achatPath(uid, request.resource.data.dernierAchat))
                  && !exists(achatPath(uid, request.resource.data.dernierAchat)))
              // Dépense de 2 crédits : uniquement en même temps que le déblocage d'une opportunité
              || (onlyKeys(['credits', 'derniereOpp'])
                  && resource.data.get('credits', 0) >= 2
                  && request.resource.data.credits == resource.data.get('credits', 0) - 2
                  && existsAfter(/databases/$(database)/documents/users/$(uid)/opps/$(request.resource.data.derniereOpp))
                  && !exists(/databases/$(database)/documents/users/$(uid)/opps/$(request.resource.data.derniereOpp)))
            ));
      allow delete: if isAdmin();

      // Documents débloqués par l'utilisateur
      match /achats/{docId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn() && request.auth.uid == uid
          && get(/databases/$(database)/documents/documents/$(docId)).data.statut == 'publie'
          && getAfter(userPath(uid)).data.dernierAchat == docId
          && getAfter(userPath(uid)).data.credits == get(userPath(uid)).data.get('credits', 0) - 1;
        allow update, delete: if false;
      }

      // Opportunités débloquées par l'utilisateur (2 crédits)
      match /opps/{oppId} {
        allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
        allow create: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/opportunites/$(oppId))
          && getAfter(userPath(uid)).data.derniereOpp == oppId
          && getAfter(userPath(uid)).data.credits == get(userPath(uid)).data.get('credits', 0) - 2;
        allow update, delete: if false;
      }
    }

    /* ---------- Opportunités : résumé public, détail réservé à ceux qui l'ont débloquée ---------- */
    match /opportunites/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /prive/{piece} {
        allow read: if isAdmin()
          || (signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)/opps/$(id)));
        allow write: if isAdmin();
      }
    }

    /* ---------- Documents ---------- */
    match /documents/{docId} {
      // Fiche visible de tous si publiée (le lien du fichier n'y est pas)
      allow read: if resource.data.statut == 'publie'
                  || (signedIn() && resource.data.auteurId == request.auth.uid)
                  || isAdmin();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['titre', 'matiere', 'filiere', 'type', 'niveau', 'annee', 'universite',
             'description', 'format', 'taille', 'nomFichier', 'imageUrl', 'auteurId', 'auteurNom',
             'statut', 'telechargements', 'creditAccorde', 'createdAt', 'suiteDe'])
        && texte('matiere', 80) && texte('filiere', 80) && texte('type', 30) && texte('niveau', 30)
        && texte('annee', 20) && texte('universite', 100) && texte('description', 600)
        && texte('format', 10) && texte('nomFichier', 200) && texte('auteurNom', 120)
        && texte('suiteDe', 40)
        && request.resource.data.auteurId == request.auth.uid
        && request.resource.data.statut == 'en_attente'
        && request.resource.data.telechargements == 0
        && request.resource.data.creditAccorde == false
        && request.resource.data.titre is string && request.resource.data.titre.size() > 0
        && request.resource.data.titre.size() <= 140
        && request.resource.data.imageUrl is string
        && (request.resource.data.imageUrl.matches(cloudinaryImage()) || request.resource.data.imageUrl.matches(stockageR2('images')));

      allow update: if isAdmin()
        // Compteur +1 seulement lors d'un vrai déblocage
        || (signedIn() && resource.data.statut == 'publie'
            && onlyKeys(['telechargements'])
            && request.resource.data.telechargements == resource.data.telechargements + 1
            && existsAfter(achatPath(request.auth.uid, docId))
            && !exists(achatPath(request.auth.uid, docId)));

      allow delete: if isAdmin();

      // Lien du fichier : auteur, admin, ou utilisateur ayant débloqué le document
      match /prive/{f} {
        allow read: if signedIn() && (
          resource.data.auteurId == request.auth.uid
          || isAdmin()
          || exists(achatPath(request.auth.uid, docId)));
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['fileUrl', 'publicId', 'auteurId', 'parts'])
          && request.resource.data.auteurId == request.auth.uid
          && getAfter(/databases/$(database)/documents/documents/$(docId)).data.auteurId == request.auth.uid
          && request.resource.data.fileUrl is string
          && (request.resource.data.fileUrl.matches(cloudinaryRaw()) || request.resource.data.fileUrl.matches(stockageR2('documents')))
          && (!('parts' in request.resource.data)
              || (request.resource.data.parts is list && request.resource.data.parts.size() <= 12));
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    /* ---------- Index de recherche (lu par tous, écrit par l'admin) ---------- */
    match /index/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ---------- Paramètres (lecture seule depuis le site) ---------- */
    match /parametres/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    /* ---------- Filières demandées (« ma filière n'est pas là ») ---------- */
    match /demandes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['filiere', 'niveau', 'universite', 'contact', 'uid', 'createdAt', 'document'])
        && texte('document', 120)
        && request.resource.data.filiere is string
        && request.resource.data.filiere.size() >= 2 && request.resource.data.filiere.size() <= 80
        && texte('niveau', 30) && texte('universite', 100) && texte('contact', 120)
        && (request.resource.data.get('uid', '') == '' || (signedIn() && request.resource.data.uid == request.auth.uid))
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    /* ---------- Parrainage : le filleul déclare son parrain une seule fois ; les crédits sont donnés par le serveur ---------- */
    match /parrainages/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['parrain', 'paye', 'createdAt'])
        && request.resource.data.parrain is string && request.resource.data.parrain.size() <= 40
        && request.resource.data.parrain != uid
        && request.resource.data.paye == false
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    /* ---------- Signalements de documents ---------- */
    match /signalements/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['docId', 'titre', 'motif', 'detail', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && texte('docId', 40) && texte('titre', 140) && texte('motif', 80) && texte('detail', 150)
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    /* ---------- Paiements ---------- */
    match /paiements/{id} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'nom', 'email', 'packs', 'montant', 'credits',
             'operateur', 'numero', 'reference', 'statut', 'createdAt'])
        && texte('nom', 80) && texte('email', 120) && texte('operateur', 30) && texte('numero', 20)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.statut == 'en_attente'
        && request.resource.data.packs is int
        && request.resource.data.packs >= 1 && request.resource.data.packs <= 10
        && request.resource.data.montant == request.resource.data.packs * prixPack()
        && request.resource.data.credits == request.resource.data.packs * creditsParPack()
        && request.resource.data.reference is string
        && request.resource.data.reference.size() >= 3 && request.resource.data.reference.size() <= 60;
      allow update, delete: if isAdmin();
    }
  }
}
