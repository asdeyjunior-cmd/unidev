# Copie ce fichier en ".env" puis remplis les valeurs. NE PARTAGE JAMAIS ce fichier.

# Cloudinary > Settings > API Keys
CLOUDINARY_CLOUD_NAME=iugeyztf
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase > Paramètres du projet > Comptes de service > Générer une nouvelle clé privée
# Place le fichier téléchargé dans ce dossier et indique son nom ici.
FIREBASE_CLE=./cle-firebase.json

# Nom affiché comme auteur des documents importés
AUTEUR_NOM=unidev
